{
  "name": "SSS - Product changed → Generate content",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "product-changed",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Product changed (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "product-changed"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.changes.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Has changes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Choose channels: if a discount price was set → discount announcement, otherwise a Telegram post\nconst body = $input.first().json.body;\nconst hasDiscount = body.changes.some(c => c.field === 'discount_price' && c.new_value);\nreturn [{ json: { productId: body.product.id, changeIds: body.changeIds, channels: hasDiscount ? ['discount'] : ['telegram'] } }];"
      },
      "name": "Pick channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -20
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SSS_API_URL }}/contents/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SSS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ productId: $json.productId, channels: $json.channels }) }}"
      },
      "name": "Generate content (AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -20
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SSS_API_URL }}/changes/mark-processed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.SSS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: $('Pick channels').first().json.changeIds }) }}"
      },
      "name": "Mark changes processed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -20
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Product changed (Webhook)": {
      "main": [
        [
          {
            "node": "Has changes?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has changes?": {
      "main": [
        [
          {
            "node": "Pick channels",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Pick channels": {
      "main": [
        [
          {
            "node": "Generate content (AI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate content (AI)": {
      "main": [
        [
          {
            "node": "Mark changes processed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tehran"
  },
  "active": false
}