# ===== Smart Store Sync (فروشگاه‌یار هوشمند) =====
# این فایل را به نام .env کپی کنید و مقادیر را تکمیل کنید.

# --- PostgreSQL ---
POSTGRES_USER=sss
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=smart_store_sync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgres://sss:change_me_strong_password@localhost:5432/smart_store_sync

# --- Backend ---
BACKEND_PORT=4000
# آدرس عمومی پنل (برای ساخت لینک فایل‌های آپلودشده در وب‌هوک و ایمیل)
PUBLIC_URL=http://localhost:4000
# کلید مشترک برای n8n و اسکریپت‌ها (هدر x-api-key). داشبورد با ورود کاربر کار می‌کند؛
# اگر خالی باشد، n8n نمی‌تواند به API دسترسی داشته باشد.
# رمزگذاری توکن ربات‌های فروشگاه‌ها در دیتابیس (یک رشتهٔ تصادفی طولانی؛ بعد از راه‌اندازی تغییر ندهید)
APP_SECRET=

API_KEY=

# --- ورود و ثبت‌نام ---
# اولین حسابی که ثبت‌نام کند مدیر (admin) می‌شود.
# برای بستن ثبت‌نام عمومی پس از ساخت حساب مدیر، مقدار false بگذارید (در محیط واقعی توصیه می‌شود).
ALLOW_REGISTRATION=true
# مدت اعتبار هر ورود (روز)
SESSION_DAYS=30
# حساب‌هایی که ایمیلشان تا این تعداد روز تأیید نشود خودکار حذف می‌شوند (حساب مدیر حذف نمی‌شود)
UNVERIFIED_TTL_DAYS=7
# آدرسی که کاربران پنل را با آن باز می‌کنند؛ لینک‌های تأیید ایمیل و بازیابی رمز با آن ساخته می‌شوند.
# در حالت توسعه (npm run dev) آدرس Vite است: http://localhost:5173 — اگر خالی باشد PUBLIC_URL استفاده می‌شود.
# اگر با https شروع شود، کوکی ورود فقط روی https ارسال می‌شود (Secure).
APP_URL=http://localhost:5173

# --- ایمیل‌های حساب کاربری (تأیید ایمیل، فراموشی رمز) ---
# اگر SMTP_HOST خالی باشد، لینک‌ها به‌جای ارسال ایمیل در لاگ سرور چاپ می‌شوند (فقط برای توسعه).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SCHEDULER_INTERVAL_SEC=60
MAX_RETRIES=3

# --- AI (هر API سازگار با OpenAI Chat Completions) ---
# اگر AI_API_KEY خالی باشد، متن‌ها با قالب آماده (بدون هوش مصنوعی) ساخته می‌شوند.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=600

# --- Telegram ---
# ربات اصلی سیستم: یک بار در @BotFather بسازید و در تنظیمات آن «Bot Management Mode» را فعال کنید.
# ربات اختصاصی هر فروشگاه از طریق همین ربات و از داخل پنل ساخته می‌شود.
TELEGRAM_BOT_TOKEN=
# اگر تلگرام فیلتر است: آدرس پروکسی HTTP (از داخل Docker، به‌جای 127.0.0.1 از host.docker.internal استفاده کنید)
# مثال v2rayN: http://host.docker.internal:10809  — در برنامه پروکسی گزینه «Allow connections from LAN» را فعال کنید
TELEGRAM_PROXY=
# TELEGRAM_API_BASE=https://api.telegram.org

# --- n8n ---
# اگر تنظیم شود، تغییرات محصولات به این وب‌هوک n8n ارسال می‌شود.
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/product-changed
N8N_WEBHOOK_URL=
N8N_USER=admin
N8N_PASSWORD=change_me
